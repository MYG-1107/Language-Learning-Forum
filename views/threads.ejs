<%- include('partials/header') %>

<div class="page-header">
  <div class="breadcrumb"><a href="/">Home</a> / All Discussions</div>
  <h1>All Discussions</h1>
  <p>Browse all community threads across every language category.</p>
  <a href="/threads/new" class="btn btn-primary">Start a Discussion</a>
</div>

<% if (threads.length === 0) { %>
  <div class="empty-state-card">
    <p>No discussions yet. <a href="/threads/new">Start the first one!</a></p>
  </div>
<% } else { %>
  <ul class="thread-list thread-list--full">
    <% threads.forEach(function(thread) { %>
      <% const cat = categories.find(c => c.id === thread.categoryId); %>
      <li class="thread-item">
        <div class="thread-meta">
          <% if (cat) { %>
            <a href="/categories/<%= cat.id %>" class="tag" style="background-color: <%= cat.color %>22; color: <%= cat.color %>; border-color: <%= cat.color %>44;">
              <%= cat.flag %> <%= cat.name %>
            </a>
          <% } %>
          <span class="thread-date"><%= thread.date %></span>
        </div>
        <a href="/threads/<%= thread.id %>" class="thread-title"><%= thread.title %></a>
        <p class="thread-excerpt"><%= thread.body.substring(0, 200) %>…</p>
        <div class="thread-footer">
          <span class="thread-author">by <%= thread.author %></span>
          <span class="reply-count"><%= thread.replies.length %> <%= thread.replies.length === 1 ? 'reply' : 'replies' %></span>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('partials/footer') %>
